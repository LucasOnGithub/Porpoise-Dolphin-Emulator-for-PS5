diff --git a/ffi/src/ps5_probe.rs b/ffi/src/ps5_probe.rs
new file mode 100644
index 0000000..2054be2
--- /dev/null
+++ b/ffi/src/ps5_probe.rs
@@ -0,0 +1,141 @@
+//! Console diagnostics using the same std, DNS, RNG and TLS as matchmaking.
+//! No account is loaded and no matchmaking ticket is created.
+use std::io::Write;
+use std::mem::{offset_of, size_of};
+use std::net::{TcpStream, ToSocketAddrs, UdpSocket};
+use std::time::{Duration, Instant};
+
+unsafe extern "C" {
+    fn slippi_ps5_validate_abi(values: *const u64, count: usize) -> i32;
+    fn slippi_ps5_getrandom(buffer: *mut u8, count: usize, flags: u32) -> isize;
+}
+
+/// Reports a completed stage: result 0 is success, a negative number is failure.
+/// Stages: 1 ABI, 2 entropy, 3 std/TLS/threads/time, 4 filesystem, 5 UDP,
+/// 6 DNS, 7 HTTPS, 8 authenticated TLS WebSocket handshake (no account/join).
+#[unsafe(no_mangle)]
+pub static SLIPPI_PS5_RUST_ABI: [u64; 36] = [
+        size_of::<libc::stat>() as _, offset_of!(libc::stat, st_size) as _,
+        offset_of!(libc::stat, st_mtime) as _, offset_of!(libc::stat, st_birthtime) as _,
+        size_of::<libc::dirent>() as _, offset_of!(libc::dirent, d_name) as _,
+        size_of::<libc::addrinfo>() as _, offset_of!(libc::addrinfo, ai_addr) as _,
+        offset_of!(libc::addrinfo, ai_canonname) as _, offset_of!(libc::addrinfo, ai_next) as _,
+        size_of::<libc::sockaddr_in>() as _, size_of::<libc::sockaddr_in6>() as _,
+        size_of::<libc::sockaddr_storage>() as _, size_of::<libc::socklen_t>() as _,
+        size_of::<libc::timespec>() as _, size_of::<libc::timeval>() as _,
+        size_of::<libc::pthread_t>() as _, size_of::<libc::pthread_key_t>() as _,
+        size_of::<libc::pthread_mutex_t>() as _, size_of::<libc::pthread_cond_t>() as _,
+        size_of::<libc::pthread_attr_t>() as _, libc::CLOCK_MONOTONIC as _,
+        libc::AF_INET as _, libc::SOL_SOCKET as _, libc::SO_ERROR as _,
+        libc::SO_RCVTIMEO as _, libc::SO_SNDTIMEO as _, libc::SO_NOSIGPIPE as _,
+        libc::FIONBIO as _, libc::SOCK_CLOEXEC as _, libc::SOCK_NONBLOCK as _,
+        libc::O_NONBLOCK as _, libc::EAGAIN as _, libc::EINPROGRESS as _,
+        libc::ETIMEDOUT as _, libc::EINTR as _,
+    ];
+#[unsafe(no_mangle)]
+pub extern "C" fn slprs_ps5_platform_probe(report: unsafe extern "C" fn(u32, i32)) -> u32 {
+    let abi = &SLIPPI_PS5_RUST_ABI;
+    let mut failures = 0;
+    macro_rules! stage {
+        ($number:expr, $pass:expr) => {{
+            let ok = $pass;
+            unsafe { report($number, if ok { 0 } else { -1 }) };
+            if !ok { failures += 1; }
+            ok
+        }};
+    }
+    if !stage!(1, unsafe { slippi_ps5_validate_abi(abi.as_ptr(), abi.len()) == 0 }) {
+        return failures;
+    }
+    let mut random = [0u8; 128];
+    if !stage!(2, unsafe { slippi_ps5_getrandom(random.as_mut_ptr(), random.len(), 0) == 128 }) {
+        return failures;
+    }
+    stage!(3, test_std().is_ok());
+    stage!(4, test_files().is_ok());
+    stage!(5, test_udp().is_ok());
+    stage!(6, ("matchmaking-dev.slippi.gg", 443).to_socket_addrs()
+        .is_ok_and(|mut addresses| addresses.any(|a| a.is_ipv4())));
+    // No custom certificate verifier or insecure fallback. Both clients use
+    // upstream's rustls + webpki roots and the console's actual wall clock.
+    stage!(7, ureq::AgentBuilder::new().timeout(Duration::from_secs(10)).build()
+        .get("https://slippi.gg/").call().is_ok());
+    stage!(8, test_websocket().is_ok());
+    failures
+}
+
+fn test_std() -> std::io::Result<()> {
+    use std::sync::{Arc, Mutex, atomic::{AtomicU32, Ordering}};
+    static DROPPED: AtomicU32 = AtomicU32::new(0);
+    struct OnExit;
+    impl Drop for OnExit { fn drop(&mut self) { DROPPED.fetch_add(1, Ordering::SeqCst); } }
+    std::thread_local! { static TLS: OnExit = const { OnExit }; }
+    DROPPED.store(0, Ordering::SeqCst);
+    let value = Arc::new(Mutex::new(0));
+    let cloned = value.clone();
+    let started = Instant::now();
+    let worker = std::thread::Builder::new().name("SlippiProbe".into()).spawn(move || {
+        TLS.with(|_| {});
+        *cloned.lock().unwrap() = 42;
+        std::thread::sleep(Duration::from_millis(10));
+    })?;
+    worker.join().map_err(|_| std::io::Error::other("thread"))?;
+    // HashMap uses std's independently rebuilt RNG path.
+    let mut map = std::collections::HashMap::new(); map.insert(1, 2);
+    if *value.lock().unwrap() != 42 || DROPPED.load(Ordering::SeqCst) != 1 ||
+        started.elapsed() < Duration::from_millis(1) || map.get(&1) != Some(&2) {
+        return Err(std::io::Error::other("std"));
+    }
+    Ok(())
+}
+
+fn test_files() -> std::io::Result<()> {
+    std::fs::create_dir_all("/data/porpoise")?;
+    let path = format!("/data/porpoise/slippi-probe-{}.tmp", std::process::id());
+    let mut file = std::fs::OpenOptions::new().read(true).write(true).create_new(true).open(&path)?;
+    let result = (|| {
+        file.write_all(b"Slippi PS5 platform probe\n")?; file.sync_all()?;
+        if file.metadata()?.len() != 26 { return Err(std::io::Error::other("stat")); }
+        drop(file);
+        let data = std::fs::read(&path)?;
+        if data != b"Slippi PS5 platform probe\n" { return Err(std::io::Error::other("read")); }
+        Ok(())
+    })();
+    let removed = std::fs::remove_file(&path);
+    result.and(removed)
+}
+
+fn test_udp() -> std::io::Result<()> {
+    let a = UdpSocket::bind("127.0.0.1:0")?;
+    let b = UdpSocket::bind("127.0.0.1:0")?;
+    b.set_read_timeout(Some(Duration::from_millis(500)))?;
+    b.set_nonblocking(true)?;
+    let mut bytes = [0u8; 32];
+    let before = Instant::now();
+    if !matches!(b.recv_from(&mut bytes), Err(ref e) if e.kind() == std::io::ErrorKind::WouldBlock) ||
+        before.elapsed() > Duration::from_millis(250) {
+        return Err(std::io::Error::other("nonblocking"));
+    }
+    b.set_nonblocking(false)?;
+    b.set_read_timeout(Some(Duration::from_secs(1)))?;
+    a.send_to(b"Slippi UDP", b.local_addr()?)?;
+    let (n, from) = b.recv_from(&mut bytes)?;
+    if &bytes[..n] != b"Slippi UDP" || from != a.local_addr()? {
+        return Err(std::io::Error::other("UDP"));
+    }
+    // Actual upstream STUN encoding, sent from the same bound UDP socket.
+    let mut request = [0; slippi_matchmaking::REQUEST_LEN];
+    slippi_matchmaking::build_binding_request(&mut request);
+    Ok(())
+}
+
+fn test_websocket() -> Result<(), ()> {
+    let address = ("matchmaking-dev.slippi.gg", 443).to_socket_addrs().map_err(|_| ())?
+        .find(|a| a.is_ipv4()).ok_or(())?;
+    let stream = TcpStream::connect_timeout(&address, Duration::from_secs(5)).map_err(|_| ())?;
+    stream.set_read_timeout(Some(Duration::from_secs(10))).map_err(|_| ())?;
+    stream.set_write_timeout(Some(Duration::from_secs(10))).map_err(|_| ())?;
+    let (mut socket, _) = tungstenite::client_tls(
+        "wss://matchmaking-dev.slippi.gg/v1/queue", stream).map_err(|_| ())?;
+    socket.close(None).map_err(|_| ())
+}
