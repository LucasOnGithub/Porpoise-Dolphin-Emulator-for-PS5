+private:
+  enum
+  {
+    CMD_UNKNOWN = 0x0,
+
+    // Recording
+    CMD_RECEIVE_COMMANDS = 0x35,
+    CMD_RECEIVE_GAME_INFO = 0x36,
+    CMD_RECEIVE_POST_FRAME_UPDATE = 0x38,
+    CMD_RECEIVE_GAME_END = 0x39,
