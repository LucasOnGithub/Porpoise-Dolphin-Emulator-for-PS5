diff --git a/CMake/Slippi.cmake b/CMake/Slippi.cmake
new file mode 100644
index 0000000..a8c79ec
--- /dev/null
+++ b/CMake/Slippi.cmake
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+set(SLIPPI_REFERENCE_SOURCE "" CACHE PATH "Pinned Slippi reference source")
+set(SLIPPI_RUST_SOURCE "" CACHE PATH "Matched Rust source with staticlib packaging")
+set(SLIPPI_PS5_BACKEND_DIR "" CACHE PATH "Audited PS5 Rust backend build directory")
+option(SLIPPI_PS5_EXPERIMENTAL "Build unverified experimental PS5 Slippi integration" OFF)
+if(DOLPHIN_PS5 AND NOT SLIPPI_PS5_EXPERIMENTAL)
+  message(FATAL_ERROR "PS5 Slippi is experimental. Build/audit its backend and explicitly enable SLIPPI_PS5_EXPERIMENTAL.")
+endif()
+if(NOT EXISTS "${SLIPPI_REFERENCE_SOURCE}/Source/Core/Core/Slippi/SlippiSavestate.cpp" OR
+   NOT EXISTS "${SLIPPI_RUST_SOURCE}/ffi/includes/SlippiRustExtensions.h")
+  message(FATAL_ERROR "Run tools/prepare-slippi-core.py to prepare the pinned sources")
+endif()
+if(NOT DOLPHIN_PS5)
+  find_program(SLIPPI_CARGO cargo HINTS "$ENV{HOME}/.cargo/bin" REQUIRED)
+endif()
+add_compile_definitions(DOLPHIN_SLIPPI)
+include_directories("${SLIPPI_REFERENCE_SOURCE}/Externals" "${SLIPPI_REFERENCE_SOURCE}/Externals/nlohmann"
+                    "${SLIPPI_RUST_SOURCE}/ffi/includes")
+add_library(slippi_semver STATIC
+  "${SLIPPI_REFERENCE_SOURCE}/Externals/semver/src/Semver200_comparator.cpp"
+  "${SLIPPI_REFERENCE_SOURCE}/Externals/semver/src/Semver200_parser.cpp"
+  "${SLIPPI_REFERENCE_SOURCE}/Externals/semver/src/Semver200_modifier.cpp")
+target_include_directories(slippi_semver PUBLIC "${SLIPPI_REFERENCE_SOURCE}/Externals/semver/include")
+set(vcdiff_build_exec OFF CACHE BOOL "" FORCE)
+set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
+set(BUILD_STATIC_LIBS ON CACHE BOOL "" FORCE)
+add_subdirectory("${SLIPPI_REFERENCE_SOURCE}/Externals/open-vcdiff" "${CMAKE_BINARY_DIR}/slippi-vcdiff")
+if(DOLPHIN_PS5)
+  set(_rust_archive "${SLIPPI_PS5_BACKEND_DIR}/libslippi_ps5.a")
+  if(NOT EXISTS "${_rust_archive}" OR
+     NOT EXISTS "${SLIPPI_PS5_BACKEND_DIR}/backend-audit.json" OR
+     NOT EXISTS "${SLIPPI_PS5_BACKEND_DIR}/runtime.o")
+    message(FATAL_ERROR "Run tools/build-slippi-ps5.sh before configuring the PS5 core")
+  endif()
+  add_library(porpoise_slippi_rust STATIC IMPORTED GLOBAL)
+  set_target_properties(porpoise_slippi_rust PROPERTIES IMPORTED_LOCATION "${_rust_archive}")
+  target_link_libraries(porpoise_slippi_rust INTERFACE "${SLIPPI_PS5_BACKEND_DIR}/runtime.o")
+  message(WARNING "Experimental PS5 Slippi backend: console and live matches are unverified")
+else()
+  file(GLOB_RECURSE _rust_inputs CONFIGURE_DEPENDS "${SLIPPI_RUST_SOURCE}/*/src/*.rs" "${SLIPPI_RUST_SOURCE}/*/Cargo.toml")
+  list(APPEND _rust_inputs "${SLIPPI_RUST_SOURCE}/Cargo.lock" "${SLIPPI_RUST_SOURCE}/ffi/build.rs")
+  set(_rust_archive "${CMAKE_BINARY_DIR}/slippi-rust/release/libslippi_rust_extensions.a")
+  add_custom_command(OUTPUT "${_rust_archive}"
+    COMMAND "${CMAKE_COMMAND}" -E env "RUSTUP_TOOLCHAIN=1.88.0" "RUSTFLAGS=-C relocation-model=pic"
+      "${SLIPPI_CARGO}" build --locked --release --no-default-features --features mainline
+      --manifest-path "${SLIPPI_RUST_SOURCE}/ffi/Cargo.toml" --target-dir "${CMAKE_BINARY_DIR}/slippi-rust"
+    DEPENDS ${_rust_inputs}
+    WORKING_DIRECTORY "${SLIPPI_RUST_SOURCE}"
+    COMMENT "Building matched Slippi Rust EXI/account/matchmaking backend" VERBATIM)
+  add_custom_target(slippi_rust_build DEPENDS "${_rust_archive}")
+  add_library(porpoise_slippi_rust STATIC IMPORTED GLOBAL)
+  set_target_properties(porpoise_slippi_rust PROPERTIES IMPORTED_LOCATION "${_rust_archive}")
+  add_dependencies(porpoise_slippi_rust slippi_rust_build)
+  find_library(SLIPPI_ALSA_LIBRARY asound REQUIRED)
+  target_link_libraries(porpoise_slippi_rust INTERFACE ${CMAKE_DL_LIBS} pthread "${SLIPPI_ALSA_LIBRARY}")
+endif()
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 01b03ec..35493bf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -497,7 +497,8 @@ if(LIBRETRO)
   set(ENABLE_PULSEAUDIO OFF CACHE BOOL "" FORCE)
   set(ENABLE_SDL OFF CACHE BOOL "" FORCE)
   set(USE_DISCORD_PRESENCE OFF CACHE BOOL "" FORCE)
-  set(USE_RETRO_ACHIEVEMENTS OFF CACHE BOOL "" FORCE)
+  # Porpoise: RetroAchievements stay available to the libretro build (the
+  # host does the HTTPS and the popups: Core/AchievementHooks.h).
   set(USE_UPNP OFF CACHE BOOL "" FORCE)
   add_definitions(-D__LIBRETRO__)
   check_and_add_flag(FPIC -fpic)
@@ -652,7 +653,7 @@ if(ENABLE_EVDEV)
   endif()
 endif()
 
-if(UNIX)
+if(UNIX AND NOT DOLPHIN_PS5)
   message(STATUS "Using named pipes as controller inputs")
   add_definitions(-DUSE_PIPES=1)
   message(STATUS "Watching game memory for changes")
@@ -780,7 +781,9 @@ if(ENABLE_CUBEB)
   add_definitions(-DHAVE_CUBEB)
 endif()
 
-if(NOT ANDROID AND NOT IOS AND NOT WEBOS)
+# PS5: no USB passthrough and no real Wii Remotes; a core reaches the pad only
+# through the frontend (libusb, hidapi and cpp-ipc are not built).
+if(NOT ANDROID AND NOT IOS AND NOT WEBOS AND NOT DOLPHIN_PS5)
   dolphin_find_optional_system_library(LibUSB Externals/libusb)
   add_definitions(-D__LIBUSB__)
 endif()
@@ -801,7 +804,7 @@ dolphin_find_optional_system_library(MBEDTLS Externals/mbedtls 2.28)
 
 dolphin_find_optional_system_library(CURL Externals/curl)
 
-if(NOT ANDROID AND NOT IOS)
+if(NOT ANDROID AND NOT IOS AND NOT DOLPHIN_PS5)
   dolphin_find_optional_system_library(HIDAPI Externals/hidapi)
 endif()
 
@@ -848,7 +851,7 @@ if (NOT IOS)
 endif()
 
 # Any other platform or BSD is currently unsupported by cpp-ipc
-if(WIN32 OR LINUX OR CMAKE_SYSTEM_NAME STREQUAL "FreeBSD" OR CMAKE_SYSTEM_NAME STREQUAL "QNX")
+if((WIN32 OR LINUX OR CMAKE_SYSTEM_NAME STREQUAL "FreeBSD" OR CMAKE_SYSTEM_NAME STREQUAL "QNX") AND NOT DOLPHIN_PS5)
   add_subdirectory(Externals/cpp-ipc)
   add_definitions(-DHAVE_CPPIPC)
 endif()
@@ -916,6 +919,10 @@ endif()
 ########################################
 # Process Dolphin source now that all setup is complete
 #
+option(ENABLE_SLIPPI "Build Slippi EXI, rollback and peer networking" OFF)
+if(ENABLE_SLIPPI)
+  include(CMake/Slippi.cmake)
+endif()
 add_subdirectory(Source)
 
 ########################################
