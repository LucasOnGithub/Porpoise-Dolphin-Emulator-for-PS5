index 0000000..fab465d
--- /dev/null
+++ b/Source/Core/Core/Slippi/SlippiSession.cpp
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "Core/Slippi/SlippiSession.h"
+#include "Common/FileUtil.h"
+#include "Common/IniFile.h"
+#include "Core/Config/GraphicsSettings.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/ConfigManager.h"
+#include "Core/HW/EXI/EXI_Device.h"
+#include "DiscIO/Volume.h"
+#include "DiscIO/VolumeDisc.h"
+#include "VideoCommon/OnScreenDisplay.h"
+namespace Slippi
+{
+bool PrepareSession(const std::string& path)
+{
+  const auto disc = DiscIO::CreateDisc(path);
+  if (!disc || disc->GetVolumeType() != DiscIO::Platform::GameCubeDisc || disc->GetGameID() != "GALE01" || disc->GetRevision().value_or(0) != 2)
+  { OSD::AddMessage("Experimental Slippi requires NTSC-U Melee 1.02.", 10000); return false; }
+  const auto sys = File::GetSysDirectory();
+  Common::IniFile profile;
+  if (!File::Exists(sys + "bootloader.gct") || !File::Exists(sys + "GameFiles/GALE01/SlippiCSS.dat") || !profile.Load(sys + "Slippi/GALE01r2.ini"))
+  { OSD::AddMessage("Matched Slippi Sys assets are missing.", 10000); return false; }
+  ::Config::SetCurrent(::Config::SLIPPI_ISO_PATH, path);
+  ::Config::SetCurrent(::Config::SLIPPI_ENABLED, true);
+  ::Config::SetCurrent(::Config::MAIN_SLOT_B, ExpansionInterface::EXIDeviceType::Slippi);
+  ::Config::SetCurrent(::Config::MAIN_ENABLE_CHEATS, true);
+  ::Config::SetCurrent(::Config::MAIN_CPU_THREAD, true);
+  ::Config::SetCurrent(::Config::MAIN_GPU_DETERMINISM_MODE, std::string("fake-completion"));
+  ::Config::SetCurrent(::Config::MAIN_FAST_DISC_SPEED, true);
+  ::Config::SetCurrent(::Config::MAIN_OVERCLOCK_ENABLE, false);
+  ::Config::SetCurrent(::Config::MAIN_OVERCLOCK, 1.0f);
+  ::Config::SetCurrent(::Config::MAIN_EMULATION_SPEED, 1.0f);
+  ::Config::SetCurrent(::Config::GFX_WIDESCREEN_HACK, false);
+  ::Config::SetCurrent(::Config::SLIPPI_SAVE_REPLAYS, false);
+  ::Config::SetCurrent(::Config::SLIPPI_ENABLE_SPECTATOR, false);
+  ::Config::SetCurrent(::Config::SLIPPI_ENABLE_JUKEBOX, false);
+  ::Config::SetCurrent(::Config::SLIPPI_ENABLE_SEEK, false);
+  ::Config::SetCurrent(::Config::SLIPPI_REPLAY_DIR, File::GetUserPath(D_SLIPPI_IDX) + "Replays");
+  return true;
+}
+}
